# ===== Copy this file to .env and fill it in. NEVER commit the real .env (it is in .gitignore): it holds secrets. =====
# docker compose reads .env from this folder automatically.

# Password of the SQL Server 'sa' account (8+ characters with upper case, lower case, digit and symbol).
MSSQL_SA_PASSWORD=Your_strong_password123!

# Ports on this machine (inside the containers both apps always listen on 8080).
API_PORT=5080
WEB_PORT=5081

# Default Admin account seeded at startup (skipped when either value is empty).
# For local dev prefer user-secrets:
#   dotnet user-secrets set "SeedAdmin:Email" "admin@example.com" --project src/SalesInventory.Api
#   dotnet user-secrets set "SeedAdmin:Password" "<strong password>" --project src/SalesInventory.Api
# As environment variables use SeedAdmin__Email / SeedAdmin__Password.
SEEDADMIN__EMAIL=
SEEDADMIN__PASSWORD=

# Anthropic API key for the AI assistant (server side only, never commit a real key).
# For local dev prefer user-secrets:
#   dotnet user-secrets set "Anthropic:ApiKey" "<your key>" --project src/SalesInventory.Api
# As an environment variable use ANTHROPIC_API_KEY (or Anthropic__ApiKey).
ANTHROPIC_API_KEY=

# Secret used to sign JWT access tokens: at least 32 random characters, different for every environment.
# For local dev use user-secrets (dotnet user-secrets set "Jwt:Key" "<random>" --project src/SalesInventory.Api).
# In production the API refuses to start if it is missing, too short, or set in a settings file (appsettings*.json).
JWT__KEY=

# Production hardening (read as Cors__AllowedOrigins__0 and Hardening__TrustedProxies__0 by the API):
# - CORS__ALLOWEDORIGINS__0: the exact origin of the Blazor client, for example https://app.example.com
#   (https only, no path, no "*"). Leave empty when no browser from another origin calls the API.
# - HARDENING__TRUSTEDPROXIES__0: the address or CIDR range of the reverse proxy that ends TLS in front of the API,
#   for example 172.18.0.0/16. Only this proxy is believed when it says the client used https (X-Forwarded-Proto).
# - HTTPS_PORT: the public https port, where plain-http requests are redirected (HSTS is sent on https responses).
CORS__ALLOWEDORIGINS__0=
HARDENING__TRUSTEDPROXIES__0=
HTTPS_PORT=443
