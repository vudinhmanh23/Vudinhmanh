# Copy to .env (already gitignored) and set a real strong password.
# Used by docker-compose.yml to configure the SQL Server container and
# the API's ConnectionStrings__DefaultConnection environment variable.
MSSQL_SA_PASSWORD=Your_strong_password123!

# Default Admin account seeded at startup (skipped when either value is empty).
# For local dev prefer user-secrets:
#   dotnet user-secrets set "SeedAdmin:Email" "admin@example.com" --project src/SalesInventory.Api
#   dotnet user-secrets set "SeedAdmin:Password" "<strong password>" --project src/SalesInventory.Api
# As environment variables use SeedAdmin__Email / SeedAdmin__Password.
SEEDADMIN__EMAIL=
SEEDADMIN__PASSWORD=
