<div class="brand-row">
    <a class="navbar-brand" href="">SalesInventory</a>
</div>

<input type="checkbox" title="Menu điều hướng" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @foreach (var item in Items)
        {
            @* Roles = null: any signed-in user; otherwise only the listed roles see the item *@
            <AuthorizeView Roles="@item.Roles">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        @item.Label
                    </NavLink>
                </div>
            </AuthorizeView>
        }
    </nav>
</div>

@code {
    // Roles mirror the API's [Authorize] rules (comma-separated, any match grants access)
    private record NavItem(string Href, string Label, string? Roles = null);

    private static readonly NavItem[] Items =
    [
        new("", "Tổng quan"),
        new("products", "Sản phẩm"),
        new("categories", "Danh mục", "Admin,Kho"),
        new("suppliers", "Nhà cung cấp", "Admin,Kho"),
        new("customers", "Khách hàng", "Admin,BanHang"),
        new("purchases", "Nhập hàng", "Admin,Kho"),
        new("sales", "Bán hàng", "Admin,BanHang,Kho"),
        new("reports", "Báo cáo", "Admin,Kho"),
    ];
}

