@page "/products/{Id:int}/edit"
@* Pages/Products/ would generate the namespace ...Pages.Products, which clashes with the Products page class *@
@namespace SalesInventory.Web.Components.Pages.ProductForms
@using System.Net
@using SalesInventory.Web.Components.Products
@using SalesInventory.Web.Models
@inject IHttpClientFactory HttpClientFactory
@inject TokenStore Tokens
@inject CatalogApi Catalog
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>Sửa sản phẩm - SalesInventory</PageTitle>

<h1>Sửa sản phẩm</h1>

<div class="form-card">
    @if (_loadError is not null)
    {
        <div class="alert alert-danger" role="alert">@_loadError</div>
    }
    else if (_isLoading)
    {
        <p><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang tải…</p>
    }
    else
    {
        <ProductForm Model="_model" Categories="_categories" Saving="_saving" Error="_error" OnValidSubmit="SaveAsync" />
    }

    <p class="mt-3"><a href="products">← Quay lại danh sách</a></p>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private readonly ProductFormModel _model = new();
    private List<CategoryItem> _categories = new();

    // The product as loaded: PUT replaces every field, so the ones the form does not show are sent back unchanged
    private ProductDetail? _original;

    private bool _isLoading = true;
    private bool _saving;
    private string? _loadError;
    private ApiError? _error;

    // Session storage needs JS interop, so load after the first interactive render
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (string.IsNullOrEmpty(await Tokens.GetAsync()))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            await LoadAsync();
        }
        finally
        {
            // Always leave the loading state, even if something unexpected was thrown above
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        var categories = await Catalog.GetCategoriesAsync();
        if (categories is null)
        {
            _loadError = "Không thể tải danh mục. Vui lòng thử lại sau";
            Toast.ShowError(_loadError);
            return;
        }

        _categories = categories;

        try
        {
            var client = HttpClientFactory.CreateClient(ApiClient.Name);
            var response = await client.GetAsync($"api/products/{Id}");

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _loadError = response.StatusCode == HttpStatusCode.NotFound
                    ? "Không tìm thấy sản phẩm"
                    : "Không thể tải sản phẩm. Vui lòng thử lại sau";
                Toast.ShowError(_loadError);
                return;
            }

            _original = await response.Content.ReadFromJsonAsync<ProductDetail>();
            if (_original is null)
            {
                _loadError = "Không thể tải sản phẩm. Vui lòng thử lại sau";
                Toast.ShowError(_loadError);
                return;
            }

            _model.Name = _original.Name;
            _model.Sku = _original.Sku;
            _model.CategoryId = _original.CategoryId;
            _model.Price = _original.SalePrice;
            _model.StockQuantity = _original.Quantity;
            _model.Description = _original.Description;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _loadError = "Không kết nối được máy chủ, vui lòng thử lại";
            Toast.ShowError(_loadError);
        }
    }

    private async Task SaveAsync()
    {
        if (_original is null)
        {
            return;
        }

        // A second click can arrive before the browser has disabled the button; ignore it
        if (_saving)
        {
            return;
        }

        _saving = true;
        _error = null;

        try
        {
            var client = HttpClientFactory.CreateClient(ApiClient.Name);
            var response = await client.PutAsJsonAsync($"api/products/{Id}", ToRequest(_original));

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Đã lưu sản phẩm");
                Navigation.NavigateTo("/products");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                // Token expired; AuthMessageHandler has already cleared it
                Navigation.NavigateTo("/login");
                return;
            }

            _error = await ApiErrorReader.ReadAsync(response);
            Toast.ShowError(_error.Message);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _error = new ApiError("Không kết nối được máy chủ, vui lòng thử lại", Array.Empty<string>());
            Toast.ShowError(_error.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    // PurchasePrice is null on purpose: the API never returns the cost price, and null tells it to keep the stored one
    private ProductWriteRequest ToRequest(ProductDetail original) => new(
        Name: _model.Name.Trim(),
        Sku: _model.Sku.Trim(),
        Description: string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim(),
        Barcode: original.Barcode,
        Unit: original.Unit,
        PurchasePrice: null,
        SalePrice: _model.Price,
        Quantity: _model.StockQuantity,
        LowStockThreshold: original.LowStockThreshold,
        ReorderLevel: original.ReorderLevel,
        IsActive: original.IsActive,
        CategoryId: _model.CategoryId);
}

